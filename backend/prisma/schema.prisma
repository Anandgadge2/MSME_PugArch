}

model Conversation {
  id            Int       @id @default(autoincrement())
  tenderId      Int?
  buyerId       Int
  sellerId      Int
  subject       String
  status        String    @default("open")
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  buyer         User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  seller        User      @relation("SellerConversations", fields: [sellerId], references: [id])
  tender        Tender?   @relation(fields: [tenderId], references: [id])
  messages      Message[]

  @@unique([tenderId, buyerId, sellerId], name: "conversationTenderPair")
  @@index([buyerId, sellerId])
  @@index([tenderId])
  @@index([status])
}

model Message {
  id             Int                 @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  status         String              @default("sent")
  createdAt      DateTime            @default(now())
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation("MessageSender", fields: [senderId], references: [id])
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model MessageAttachment {
  id          Int      @id @default(autoincrement())
  messageId   Int
  fileAssetId Int
  createdAt   DateTime @default(now())
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([fileAssetId])
}

model Dispute {
  id                    Int                 @id @default(autoincrement())
  purchaseOrderId       Int?
  paymentTransactionId  Int?
  escrowAccountId       Int?
  buyerId               Int
  sellerId              Int
  raisedById            Int
  category              String
  reason                String
  status                String              @default("open")
  resolutionRemarks     String?
  resolvedById          Int?
  resolvedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  statusEnum            DisputeStatus?
  disputeNo             String?             @unique
  raisedByUserId        Int?
  raisedByOrgId         Int?
  againstOrgId          Int?
  buyerOrgId            Int?
  sellerOrgId           Int?
  linkedEntityType      String?
  linkedEntityId        Int?
  invoiceId             Int?
  deliveryId            Int?
  grnId                 Int?
  requirementResponseId Int?
  auctionId             Int?
  title                 String?
  description           String?
  amountInDispute       Decimal?            @db.Decimal(18, 2)
  priority              DisputePriority     @default(MEDIUM)
  assignedAdminId       Int?
  adminRemarks          String?
  resolutionSummary     String?
  closedAt              DateTime?
  againstOrg            Organization?       @relation("DisputeAgainstOrg", fields: [againstOrgId], references: [id])
  assignedAdmin         User?               @relation("AssignedDisputes", fields: [assignedAdminId], references: [id])
  buyer                 User                @relation("BuyerDisputes", fields: [buyerId], references: [id])
  buyerOrg              Organization?       @relation("DisputeBuyerOrg", fields: [buyerOrgId], references: [id])
  raisedBy              User                @relation("RaisedDisputes", fields: [raisedById], references: [id])
  raisedByOrg           Organization?       @relation("DisputeRaisedOrg", fields: [raisedByOrgId], references: [id])
  resolvedBy            User?               @relation("ResolvedDisputes", fields: [resolvedById], references: [id])
  seller                User                @relation("SellerDisputes", fields: [sellerId], references: [id])
  sellerOrg             Organization?       @relation("DisputeSellerOrg", fields: [sellerOrgId], references: [id])
  attachments           DisputeAttachment[]
  evidence              DisputeEvidence[]
  messages              DisputeMessage[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([raisedById])
  @@index([status])
  @@index([raisedByOrgId])
  @@index([againstOrgId])
  @@index([assignedAdminId])
  @@index([linkedEntityType, linkedEntityId])
  @@index([purchaseOrderId])
  @@index([invoiceId])
  @@index([paymentTransactionId])
  @@index([deliveryId])
  @@index([grnId])
  @@index([escrowAccountId])
  @@index([requirementResponseId])
  @@index([auctionId])
  @@index([statusEnum])
  @@index([createdAt])
}

model DisputeMessage {
  id          Int                      @id @default(autoincrement())
  disputeId   Int
  senderId    Int
  content     String
  internal    Boolean                  @default(false)
  createdAt   DateTime                 @default(now())
  senderOrgId Int?
  message     String?
  visibility  DisputeMessageVisibility @default(PUBLIC_TO_PARTIES)
  dispute     Dispute                  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  sender      User                     @relation("DisputeMessageSender", fields: [senderId], references: [id])
  senderOrg   Organization?            @relation("DisputeMessageOrg", fields: [senderOrgId], references: [id])

  @@index([disputeId, createdAt])
  @@index([senderId, createdAt])
  @@index([senderOrgId])
}

model DisputeEvidence {
  id           Int      @id @default(autoincrement())
  disputeId    Int
  fileAssetId  Int
  uploadedById Int
  description  String?
  createdAt    DateTime @default(now())
  dispute      Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("DisputeEvidenceUploader", fields: [uploadedById], references: [id])

  @@index([disputeId])
  @@index([fileAssetId])
}

model DisputeAttachment {
  id               Int      @id @default(autoincrement())
  disputeId        Int
  fileAssetId      Int
  uploadedByUserId Int
  createdAt        DateTime @default(now())
  dispute          Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
