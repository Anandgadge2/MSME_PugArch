  fileSize         Int
  documentStatus   ProcurementDocumentStatus   @default(UPLOADED)
  uploadedAt       DateTime                    @default(now())
  participation    ProcurementBidParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  seller           User                        @relation("ProcurementBidParticipationDocumentUploader", fields: [sellerId], references: [id])

  @@index([participationId, documentCategory])
  @@index([bidId, sellerId])
}

model ProcurementBidClarification {
  id                Int                               @id @default(autoincrement())
