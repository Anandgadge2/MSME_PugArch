{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "postinstall": "npx prisma generate",
    "db:migrate": "npx prisma migrate deploy",
    "vercel-build": "npx prisma generate && tsc",
    "build": "node -e \"try { require('child_process').execSync('npx prisma generate', { stdio: 'pipe' }); console.log('Prisma client generated successfully.'); } catch (e) { console.log('Notice: Using existing Prisma client (dev server is active).'); }\" && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "lint:security": "eslint index.ts src --ext .ts --max-warnings=0",
    "prisma:validate": "npx prisma validate",
    "test:security": "node --test tests/security.test.mjs",
    "test:integration": "node --test tests/phase8.integration.test.mjs",
    "test:delivery": "node --test tests/delivery.test.mjs",
    "test:transaction-2fa": "node --test tests/transaction-2fa.test.mjs",
    "audit:deps": "npm audit --workspace=backend --audit-level=critical",
    "db:empty-preserve-admins": "tsx scripts/empty-db-preserve-admins.ts",
    "cleanup:seed-data": "tsx scripts/cleanup-seed-data.ts",
    "backfill:org-membership": "tsx scripts/backfill-org-membership.ts",
    "attach-user-to-org": "tsx scripts/attach-user-to-org.ts",
    "security:check": "npm run typecheck && npm run prisma:validate && npm run lint:security && npm run test:security && npm run audit:deps",
    "vercel-build:with-migrate": "npm run db:migrate && npm run vercel-build"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@prisma/client": "^6.19.3",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "ws": "^8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
